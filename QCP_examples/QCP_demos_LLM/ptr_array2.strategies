#include "ptr_array2_def.h"

id : 1
priority : core(1)
left : CharPtrArray2::full(?p, ?n, ?rows) at 0
right : data_at(?p + (?i * sizeof(PTR)), PTR, ?v) at 1
check : infer(0 <= i);
        infer(i < n);
action : right_erase(1);
         left_erase(0);
         left_exist_add(row_ptr);
         left_add(CharPtrArray2::missing_i(p, n, i, row_ptr, rows));
         left_add(CharArray::full(row_ptr, Zlength{Z}(rows[i]), rows[i]));
         right_add(v == row_ptr);

id : 2
priority : post(1)
left : CharPtrArray2::missing_i(?p, ?n, ?i, ?row_ptr, ?rows) at 0
       CharArray::full(row_ptr, Zlength{Z}(rows[i]), rows[i]) at 1
       data_at(p + i * sizeof(PTR), PTR, row_ptr) at 2
check : infer(0 <= i);
        infer(i < n);
action : left_erase(2);
         left_erase(1);
         left_erase(0);
         left_add(CharPtrArray2::full(p, n, rows));

id : 4
priority : core(1)
left : CharPtrArray2::full(?p, ?n, ?rows1) at 0
right : CharPtrArray2::full(p, n, ?rows2) at 1
action : right_erase(1);
         left_erase(0);
         right_add(rows1 == rows2);

id : 5
priority : core(1)
left : CharPtrArray2::missing_i(?p, ?n, ?i, ?row_ptr, ?rows) at 0
right : CharPtrArray2::missing_i(p, n, i, row_ptr, rows) at 1
action : left_erase(0);
         right_erase(1);

id : 11
priority : core(1)
left : PtrArray::seg(?p, ?x, ?y, ?l) at 0
right : store(?p + (?i * sizeof(PTR)), PTR, ?v) at 1
check : infer(x <= i);
        infer(i < y);
action : right_erase(1);
         left_erase(0);
         left_add(PtrArray::missing_i(p, i, x, y, l));
         right_add(v == l[i - x]);

id : 12
priority : post(4)
left : PtrArray::missing_i(?p, ?i, ?x, ?y, ?l) at 0
       store(p + ?i * sizeof(PTR), PTR, ?v) at 1
check : infer(x <= i);
        infer(i < y);
action : left_erase(1);
         left_erase(0);
         left_add(PtrArray::seg(p, x, y, replace_Znth{Z}(i - x, v, l)));

id : 13
priority : core(1)
left : PtrArray::seg(?p, ?x, ?z, ?l3) at 2
right : PtrArray::seg(?p, ?x, ?y, ?l1) at 0
        PtrArray::seg(?p, ?y, ?z, ?l2) at 1
check : infer(y <= z);
        infer(x <= y);
action : left_erase(2);
         right_erase(0);
         right_erase(1);
         right_add(l3 == app{Z}(l1, l2));
         right_add(Zlength{Z}(l1) == y - x);

id : 14
priority : core(1)
right : PtrArray::seg(?p, ?x, ?x, ?l) at 0
action : right_erase(0);
         right_add(l == nil{Z});

id : 15
priority : core(1)
left : PtrArray::undef_seg(?p, ?x, ?z) at 2
right : PtrArray::undef_seg(?p, ?x, ?y) at 0
        PtrArray::undef_seg(?p, ?y, ?z) at 1
check : infer(y <= z);
        infer(x <= y);
action : left_erase(2);
         right_erase(0);
         right_erase(1);

id : 16
priority : post(1)
left : PtrArray::seg(?p, ?x, ?y, ?l1) at 0
       PtrArray::seg(?p, ?y, ?z, ?l2) at 1
right : PtrArray::seg(?p, ?x, ?z, ?l3) at 2
check : infer(y <= z);
        infer(x <= y);
action : right_erase(2);
         left_erase(0);
