  "problem_context": {
    "problem_statement": "Verify the faithful QCP C transcription of CertiUCOS ucos_Grant_Cap_impl.",
    "target_function": "ucos_Grant_Cap",
    "expected_behavior": "Return 11 without changing the CSpace table when cap_Class is outside 0..16, destTask_Prio is outside 0..63, or the destination CSpace pointer is null. Otherwise update exactly the destination slot: cap_type becomes 1, category_content becomes cap_Class, category_right becomes (old_right & 4095) | cap_Right, preserve all unrelated memory, and return 0.",
    "input_output_contract": "Inputs are uint8 destTask_Prio and uint32 cap_Class/cap_Right. Model OSCSpacePrioTbl as a 64-entry global pointer array and each CSpace as containing 255 slots. The postcondition must distinguish exact failure and success behavior and frame all unrelated table entries, CSpaces, slots, and fields.",
    "spec_hint": [
      "Use local array/slot representation predicates with missing-index or segment decomposition rather than unfolding all 64 table entries or 255 slots.",
      "Preserve unsigned semantics: CAP_NULL_CLASS > cap_Class is unreachable, so class 0 is accepted; do not silently strengthen the implementation.",
      "The successful rights value is exactly (old_right & 4095) | cap_Right; cap_Right itself is not masked."
    ],
    "preferred_hidden_properties": [
      "Only the selected destination slot changes on success; every other table entry, CSpace, slot, and field is preserved."
    ],
    "forbidden_patterns": [
      "Do not weaken the specification to return codes only.",
      "Do not add Admitted, Abort, extra Axiom, or modify generated Rocq artifacts by hand."
    ]
